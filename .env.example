# Demonstration defaults only. Keep .env out of version control.
MIGRATOR_DB_PASSWORD=course_migrator
APP_DB_PASSWORD=course_app
PUBLIC_DB_PASSWORD=course_public
# Local development URL; compose supplies its internal database URLs separately.
DATABASE_URL=postgresql+psycopg://course_app:course_app@localhost:5432/courses
PUBLIC_DATABASE_URL=postgresql+psycopg://course_public:course_public@localhost:5432/courses
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
FRONTEND_PORT=8080
API_PORT=8000
MAILPIT_PORT=8025
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Enable only for deterministic local tests. Real acceptance must use false.
CHAT_STUB=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=courses@example.test
SMTP_STARTTLS=false
