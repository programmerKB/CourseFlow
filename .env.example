# Demonstration defaults only. Keep .env out of version control.
MIGRATOR_DB_PASSWORD=course_migrator
APP_DB_PASSWORD=course_app
PUBLIC_DB_PASSWORD=course_public
# Local development URL; compose supplies its internal database URLs separately.
DATABASE_URL=postgresql+psycopg://course_app:course_app@localhost:5432/courses
PUBLIC_DATABASE_URL=postgresql+psycopg://course_public:course_public@localhost:5432/courses
APP_ORIGIN=http://localhost:8080
# Optional additional exact browser origins, separated by commas (include the port).
# APP_ALLOWED_ORIGINS=http://192.168.1.20:8080
APP_ALLOWED_ORIGINS=
COOKIE_SECURE=false
# 115-1 initial-only demo. Leave empty to use the configured registration phases.
PUBLIC_INITIAL_TERM_ID=8abc15dd-c1b8-53ed-a570-ae723e17a762
# Set both as ISO 8601 datetimes with a timezone to update the 115-1 initial period.
# INITIAL_START_AT=2026-11-24T09:00:00+08:00
# INITIAL_END_AT=2026-11-30T23:59:00+08:00
INITIAL_START_AT=
INITIAL_END_AT=
FRONTEND_PORT=8080
# Activate optional TLS with ./deploy.sh --https or COMPOSE_PROFILES=https.
# COMPOSE_PROFILES=https
# HTTPS_PORT=8443
API_PORT=8000
MAILPIT_PORT=8025
# Enable only for deterministic local tests. Real acceptance must use false.
CHAT_STUB=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=courses@example.test
SMTP_STARTTLS=false
# Both assistants (English add/drop and the Chinese query planner) use Llama 3.2 3B through LangGraph.
# No cloud language model is used.
# ./deploy.sh --llm starts the bundled Ollama service and pulls LLAMA_MODEL.
# For a remote OpenAI-compatible server set LLAMA_API_STYLE=openai, its base URL and LLAMA_API_KEY.
# Ollama on the Windows host of a VMware NAT VM: use the Windows "VMnet8" IPv4 address, e.g.
#   LLAMA_BASE_URL=http://192.168.169.1:11434
# Check it from the VM with scripts/check-ollama.sh, and do not pass --llm to deploy.sh in that case.
LLAMA_BASE_URL=http://ollama:11434
LLAMA_API_STYLE=ollama
LLAMA_MODEL=llama3.2:3b
LLAMA_API_KEY=
LLAMA_TIMEOUT_SECONDS=45
# Voice input: speech-to-text runs inside the API container with faster-whisper (no external service).
# base needs about 400 MB of memory; small is more accurate but needs about 1 GB. Changing
# WHISPER_MODEL takes effect after rebuilding (./deploy.sh without --no-build).
WHISPER_MODEL=base
WHISPER_CPU_THREADS=2
WHISPER_PRELOAD=true
# Registration confirmation emails use the Gmail API (users.messages.send, gmail.send scope).
# Create the refresh token with scripts/gmail-oauth.py. Keep real values only in .env.
# GMAIL_TRANSPORT=dev-smtp previews the same message in Mailpit and is not valid for acceptance.
GMAIL_TRANSPORT=api
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
